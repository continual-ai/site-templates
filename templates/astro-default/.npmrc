# Allow all dependency install scripts. pnpm 11 blocks install scripts by
# default; this setting opts the scaffolded site into letting them run.
#
# Rationale: scaffolded sites run inside a managed Daytona sandbox under
# Continual's agent. All dependencies come from the npm registry. The
# alternative — maintaining a per-template allowlist that has to be kept in
# sync with whatever transitive deps add postinstall scripts — is brittle and
# silently breaks `pnpm install` when something new shows up (the user-
# visible failure is an ERR_PNPM_IGNORED_BUILDS error mid-build).
#
# This file ships with the template and ends up at the root of every site
# the agent scaffolds.
dangerously-allow-all-builds=true
